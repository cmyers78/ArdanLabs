.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Debug files
__debug_bin*

# Air live reload
tmp/

# Compiled binary (based on your project structure)
/cmd/*/practical_go
/practical_go
